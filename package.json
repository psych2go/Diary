{
  "name": "my-diary",
  "version": "1.0.0",
  "private": true,
  "description": "A minimal, self-hosted Markdown diary.",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "DIARY_PASSWORD=diary-dev-password node --watch server.js",
    "test": "node --test",
    "password:hash": "sh scripts/hash-password.sh",
    "android:icons": "node scripts/generate-icons.mjs",
    "android:build": "sh android/build.sh",
    "android:verify": "sh android/verify-domain.sh"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@resvg/resvg-js": "2.6.2"
  }
}
